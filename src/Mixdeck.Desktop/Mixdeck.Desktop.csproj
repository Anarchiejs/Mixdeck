<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Mixdeck.Desktop</RootNamespace>
    <AssemblyName>Mixdeck</AssemblyName>
    <AvaloniaUseCompiledBindingsByDefault>false</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="Avalonia.Fonts.Inter" />
    <PackageReference Include="Microsoft.Extensions.Logging" />
    <PackageReference Include="Velopack" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="..\..\fl\Mixdeck\device_Mixdeck.py" Link="fl\Mixdeck\device_Mixdeck.py" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Mixdeck.Core\Mixdeck.Core.csproj" />
    <ProjectReference Include="..\Mixdeck.Voicemeeter\Mixdeck.Voicemeeter.csproj" />
    <ProjectReference Include="..\Mixdeck.FlStudio\Mixdeck.FlStudio.csproj" />
    <ProjectReference Include="..\Mixdeck.Platform.Desktop\Mixdeck.Platform.Desktop.csproj" />
  </ItemGroup>
  <ItemGroup>
    <AvaloniaResource Include="..\Mixdeck.App\Assets\Mixdeck-256.png" Link="Assets\Mixdeck-256.png" />
  </ItemGroup>
</Project>
