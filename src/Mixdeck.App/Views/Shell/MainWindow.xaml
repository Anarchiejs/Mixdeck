<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Mixdeck.App.Views.Shell.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:shared="using:Mixdeck.App.ViewModels.Shared"
    >
    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid x:Name="Root">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TitleBar x:Uid="MainWindow002"
            x:Name="AppTitleBar"

            IsBackButtonVisible="False"
            IsPaneToggleButtonVisible="True"
            PaneToggleRequested="OnPaneToggleRequested"
            Subtitle="{x:Bind Mixer.ActiveProfile.Name, Mode=OneWay}">
            <TitleBar.IconSource>
                <ImageIconSource ImageSource="ms-appx:///Assets/Mixdeck-256.png" />
            </TitleBar.IconSource>
            <TitleBar.RightHeader>
                <StackPanel
                    Margin="0,0,8,0"
                    Orientation="Horizontal"
                    Spacing="8">
                    <!-- État de la connexion, toujours visible -->
                    <Border
                        Padding="10,4"
                        VerticalAlignment="Center"
                        Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                        CornerRadius="12"
                        ToolTipService.ToolTip="{x:Bind Mixer.ConnectionMessage, Mode=OneWay}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <Ellipse
                                Width="8"
                                Height="8"
                                VerticalAlignment="Center"
                                Fill="{x:Bind shared:ShellConverters.ConnectionBrush(Mixer.IsConnected), Mode=OneWay}" />
                            <TextBlock
                                VerticalAlignment="Center"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Text="{x:Bind shared:ShellConverters.ConnectionShort(Mixer.IsConnected), Mode=OneWay}" />
                        </StackPanel>
                    </Border>
                    <ToggleButton
                        VerticalAlignment="Center"
                        AutomationProperties.Name="{x:Bind shared:Converters.MicLabel(Mixer.IsMicMuted), Mode=OneWay}"
                        IsChecked="{x:Bind Mixer.Mic.IsMuted, Mode=TwoWay}"
                        IsEnabled="{x:Bind Mixer.IsConnected, Mode=OneWay}"
                        ToolTipService.ToolTip="{x:Bind shared:Converters.MicLabel(Mixer.IsMicMuted), Mode=OneWay}">
                        <FontIcon FontSize="14" Glyph="{x:Bind shared:Converters.MicGlyph(Mixer.IsMicMuted), Mode=OneWay}" />
                    </ToggleButton>
                </StackPanel>
            </TitleBar.RightHeader>
        </TitleBar>

        <NavigationView
            x:Name="Navigation"
            Grid.Row="1"
            IsBackButtonVisible="Collapsed"
            IsPaneToggleButtonVisible="False"
            IsSettingsVisible="False"
            OpenPaneLength="220"
            PaneDisplayMode="Left"
            SelectionChanged="OnNavigationSelectionChanged">
            <NavigationView.MenuItems>
                <NavigationViewItem x:Uid="MainWindow003"  Tag="Mixer">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE9E9;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Uid="MainWindow004"  Tag="Routing">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE8AB;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Uid="MainWindow005"  Tag="Devices">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE7F5;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Uid="MainWindow006"  Tag="Profiles">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE8F1;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Uid="MainWindow007"  Tag="Rules">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE945;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>
            <NavigationView.FooterMenuItems>
                <NavigationViewItem x:Uid="MainWindow008"  Tag="Settings">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE713;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Uid="MainWindow009"  Tag="About">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE946;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.FooterMenuItems>

            <Frame x:Name="ContentFrame" CacheSize="0" IsNavigationStackEnabled="False" Navigated="OnFrameNavigated" />
        </NavigationView>
    </Grid>
</Window>
