<UserControl
    x:Class="Mixdeck.App.Views.Pages.Common.ChannelCard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Mixdeck.App.Controls"
    xmlns:shared="using:Mixdeck.App.ViewModels.Shared">
    <Border x:Name="Card" Style="{StaticResource MixdeckCardStyle}" Padding="12" Width="136">
        <StackPanel Spacing="12">
            <Grid>
                <Button x:Uid="ChannelCard001" HorizontalAlignment="Left" Click="OnIconClick" Style="{StaticResource SubtleButtonStyle}"
                         >
                    <FontIcon Glyph="{x:Bind Model.Icon, Mode=OneWay}" FontSize="20" />
                </Button>
                <Button x:Uid="ChannelCard002" HorizontalAlignment="Right" Click="OnMenuClick" Style="{StaticResource SubtleButtonStyle}"
                         >
                    <FontIcon Glyph="&#xE712;" FontSize="16" />
                </Button>
            </Grid>
            <controls:ChannelHeader x:Uid="ChannelCard003" x:Name="Header" ChannelName="{x:Bind Model.DisplayName, Mode=OneWay}"
                Icon="" NameCommitted="OnNameCommitted"  />
            <TextBlock Text="{x:Bind KindText}" Style="{StaticResource CaptionTextBlockStyle}"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <Grid Height="192" ColumnSpacing="4">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="48" /></Grid.ColumnDefinitions>
                <controls:VuMeter x:Uid="ChannelCard004" LeftDb="{x:Bind Model.LeftDb, Mode=OneWay}" RightDb="{x:Bind Model.RightDb, Mode=OneWay}"
                    LeftPeakDb="{x:Bind Model.LeftPeakDb, Mode=OneWay}" RightPeakDb="{x:Bind Model.RightPeakDb, Mode=OneWay}"
                    IsMuted="{x:Bind Model.IsMuted, Mode=OneWay}" IsClipped="{x:Bind Model.IsClipped, Mode=OneWay}"
                    ShowScale="True" IsStereo="True"  />
                <controls:Fader x:Uid="ChannelCard005" Grid.Column="1" Orientation="Vertical" HorizontalAlignment="Center"
                    Value="{x:Bind Model.Gain, Mode=TwoWay}" IsMuted="{x:Bind Model.IsMuted, Mode=OneWay}"
                      />
            </Grid>
            <TextBlock Text="{x:Bind shared:Converters.Db(Model.Gain), Mode=OneWay}" HorizontalAlignment="Center"
                       Style="{StaticResource BodyStrongTextBlockStyle}" />
            <controls:MuteToggle x:Uid="ChannelCard006" IsChecked="{x:Bind Model.IsMuted, Mode=TwoWay}" HorizontalAlignment="Stretch"
                AutomationProperties.Name="{x:Bind shared:Converters.MuteLabel(Model.IsMuted), Mode=OneWay}"  />
            <StackPanel Spacing="8" Visibility="{x:Bind IsStrip}">
                <ToggleButton x:Uid="ChannelCard007"  IsChecked="{x:Bind Strip.IsSolo, Mode=TwoWay}" HorizontalAlignment="Stretch" />
                <TextBlock x:Uid="ChannelCard008"  Style="{StaticResource CaptionTextBlockStyle}" />
                <Slider x:Uid="ChannelCard009" Minimum="-0.5" Maximum="0.5" StepFrequency="0.01" SmallChange="0.01" LargeChange="0.1"
                    Value="{x:Bind Strip.PanX, Mode=TwoWay}" DoubleTapped="OnPanDoubleTapped" IsThumbToolTipEnabled="False"
                      />
                <Grid><TextBlock x:Uid="ChannelCard010"  Style="{StaticResource CaptionTextBlockStyle}" /><TextBlock x:Uid="ChannelCard011"  HorizontalAlignment="Right" Style="{StaticResource CaptionTextBlockStyle}" /></Grid>
                <TextBlock x:Uid="ChannelCard012"  Style="{StaticResource CaptionTextBlockStyle}" />
                <ItemsRepeater ItemsSource="{x:Bind Strip.Routes, Mode=OneWay}">
                    <ItemsRepeater.Layout><UniformGridLayout MinItemWidth="32" MinItemHeight="32" MaximumRowsOrColumns="3" MinColumnSpacing="4" MinRowSpacing="4" /></ItemsRepeater.Layout>
                    <ItemsRepeater.ItemTemplate>
                        <DataTemplate x:DataType="shared:RouteViewModel">
                            <controls:RouteButton Bus="{x:Bind BusName}" IsChecked="{x:Bind IsOn, Mode=TwoWay}" MinWidth="32" Padding="4" />
                        </DataTemplate>
                    </ItemsRepeater.ItemTemplate>
                </ItemsRepeater>
                <StackPanel Spacing="4" Visibility="{x:Bind HasEq}">
                    <TextBlock x:Uid="ChannelCard013"  Style="{StaticResource BodyStrongTextBlockStyle}" Margin="0,8,0,4" />
                    <TextBlock x:Uid="ChannelCard014"  Style="{StaticResource CaptionTextBlockStyle}" />
                    <Slider x:Uid="ChannelCard015" Minimum="-12" Maximum="12" StepFrequency="0.5" Value="{x:Bind Strip.EqLow, Mode=TwoWay}" IsThumbToolTipEnabled="False"  />
                    <TextBlock Text="{x:Bind shared:Converters.Db(Strip.EqLow), Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}" />
                    <TextBlock x:Uid="ChannelCard016"  Style="{StaticResource CaptionTextBlockStyle}" />
                    <Slider x:Uid="ChannelCard017" Minimum="-12" Maximum="12" StepFrequency="0.5" Value="{x:Bind Strip.EqMid, Mode=TwoWay}" IsThumbToolTipEnabled="False"  />
                    <TextBlock Text="{x:Bind shared:Converters.Db(Strip.EqMid), Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}" />
                    <TextBlock x:Uid="ChannelCard018"  Style="{StaticResource CaptionTextBlockStyle}" />
                    <Slider x:Uid="ChannelCard019" Minimum="-12" Maximum="12" StepFrequency="0.5" Value="{x:Bind Strip.EqHigh, Mode=TwoWay}" IsThumbToolTipEnabled="False"  />
                    <TextBlock Text="{x:Bind shared:Converters.Db(Strip.EqHigh), Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}" />
                </StackPanel>
            </StackPanel>
            <StackPanel Spacing="8" Visibility="{x:Bind IsBus}">
                <ToggleButton x:Uid="ChannelCard020"  IsChecked="{x:Bind Bus.IsMono, Mode=TwoWay}" HorizontalAlignment="Stretch" />
                <ToggleButton x:Uid="ChannelCard021"  IsChecked="{x:Bind Bus.EqOn, Mode=TwoWay}" Visibility="{x:Bind Bus.HasEq}" HorizontalAlignment="Stretch" />
            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>
