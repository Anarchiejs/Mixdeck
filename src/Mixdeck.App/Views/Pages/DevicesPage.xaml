<?xml version="1.0" encoding="utf-8" ?>
<Page x:Class="Mixdeck.App.Views.Pages.DevicesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Mixdeck.App.ViewModels.Pages"
    xmlns:audio="using:Mixdeck.Core.Audio"
    xmlns:settings="using:Mixdeck.App.Views.Pages.Settings"
    Loaded="OnLoaded" Unloaded="OnUnloaded">
    <Page.Resources>
        <DataTemplate x:Key="DeviceTemplate" x:DataType="vm:DeviceRowViewModel">
            <Border Style="{StaticResource MixdeckCardStyle}">
                <StackPanel Spacing="8">
                    <TextBlock Text="{x:Bind Name, Mode=OneWay}" Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <TextBlock Text="{x:Bind Kind}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <ComboBox ItemsSource="{x:Bind Choices}" SelectedItem="{x:Bind SelectedDevice, Mode=TwoWay}"
                              HorizontalAlignment="Stretch" IsEnabled="{x:Bind Owner.CanEdit, Mode=OneWay}" AutomationProperties.Name="{x:Bind Name, Mode=OneWay}">
                        <ComboBox.ItemTemplate><DataTemplate x:DataType="vm:DeviceChoice"><TextBlock Text="{x:Bind Name}" TextTrimming="CharacterEllipsis" /></DataTemplate></ComboBox.ItemTemplate>

                    </ComboBox>
                    <TextBlock Text="{x:Bind CurrentName, Mode=OneWay}" TextWrapping="Wrap" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
            </Border>
        </DataTemplate>
    </Page.Resources>
    <ScrollViewer HorizontalScrollMode="Disabled" VerticalScrollBarVisibility="Auto">
        <StackPanel Padding="{StaticResource MixdeckPagePadding}" Spacing="24" MaxWidth="1040">
            <TextBlock x:Uid="DevicesPage001" Style="{StaticResource TitleTextBlockStyle}"  />
            <InfoBar IsOpen="{x:Bind ViewModel.HasMessage, Mode=OneWay}" IsClosable="False" Severity="{x:Bind ViewModel.Severity, Mode=OneWay}" Message="{x:Bind ViewModel.Message, Mode=OneWay}" />
            <!-- L6 : périphériques Windows par défaut. -->
            <Border Style="{StaticResource MixdeckCardStyle}">
                <StackPanel Spacing="12">
                    <TextBlock x:Uid="L6DefaultsTitle" Style="{StaticResource SubtitleTextBlockStyle}" TextWrapping="Wrap" />
                    <TextBlock x:Uid="L6DefaultsDescription" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                    <TextBlock x:Uid="L6OutputLabel" Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <ComboBox x:Uid="L6DefaultOutput" HorizontalAlignment="Stretch"
                        ItemsSource="{x:Bind WindowsDefaults.Outputs}" DisplayMemberPath="Name"
                        SelectedItem="{x:Bind WindowsDefaults.SelectedOutput, Mode=TwoWay}"
                        IsEnabled="{x:Bind WindowsDefaults.CanEdit, Mode=OneWay}" />
                    <TextBlock x:Uid="L6InputLabel" Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <ComboBox x:Uid="L6DefaultInput" HorizontalAlignment="Stretch"
                        ItemsSource="{x:Bind WindowsDefaults.Inputs}" DisplayMemberPath="Name"
                        SelectedItem="{x:Bind WindowsDefaults.SelectedInput, Mode=TwoWay}"
                        IsEnabled="{x:Bind WindowsDefaults.CanEdit, Mode=OneWay}" />
                    <InfoBar IsClosable="False" Severity="Error"
                        IsOpen="{x:Bind WindowsDefaults.HasError, Mode=OneWay}"
                        Message="{x:Bind WindowsDefaults.ErrorMessage, Mode=OneWay}" />
                </StackPanel>
            </Border>
            <StackPanel Spacing="8">
                <TextBlock x:Uid="DevicesPage002"  Style="{StaticResource SubtitleTextBlockStyle}" />
                <TextBlock x:Uid="DevicesPage003"  TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <Button Command="{x:Bind ViewModel.RefreshDevicesCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE72C;" FontSize="16" /><TextBlock x:Uid="DevicesPage004"  /></StackPanel>
                </Button>
                <ProgressBar x:Uid="DevicesPage005" IsIndeterminate="{x:Bind ViewModel.IsRefreshing, Mode=OneWay}" Visibility="{x:Bind ViewModel.IsRefreshing, Mode=OneWay}"  />
                <StackPanel Spacing="8">
                    <TextBlock x:Uid="DevicesPage006"  Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <ItemsRepeater ItemsSource="{x:Bind ViewModel.Inputs}" ItemTemplate="{StaticResource DeviceTemplate}"><ItemsRepeater.Layout><StackLayout Spacing="8" /></ItemsRepeater.Layout></ItemsRepeater>
                    <TextBlock x:Uid="DevicesPage007"  Style="{StaticResource BodyStrongTextBlockStyle}" Margin="0,8,0,0" />
                    <ItemsRepeater ItemsSource="{x:Bind ViewModel.Outputs}" ItemTemplate="{StaticResource DeviceTemplate}"><ItemsRepeater.Layout><StackLayout Spacing="8" /></ItemsRepeater.Layout></ItemsRepeater>
                </StackPanel>
            </StackPanel>
            <StackPanel Spacing="8">
                <TextBlock x:Uid="DevicesPage008"  Style="{StaticResource SubtitleTextBlockStyle}" />
                <Border Style="{StaticResource MixdeckCardStyle}"><StackPanel Spacing="12">
                    <TextBlock Text="{x:Bind ViewModel.MicName, Mode=OneWay}" Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <TextBlock x:Uid="DevicesPage009"  TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <ComboBox x:Uid="DevicesPage010" ItemsSource="{x:Bind ViewModel.Presets}" SelectedItem="{x:Bind ViewModel.SelectedPreset, Mode=TwoWay}" DisplayMemberPath="Name" IsEnabled="{x:Bind ViewModel.CanApplyPreset, Mode=OneWay}" HorizontalAlignment="Stretch"  />
                    <TextBlock Text="{x:Bind ViewModel.SelectedPreset.Description, Mode=OneWay}" TextWrapping="Wrap" />
                    <Button x:Uid="DevicesPage011"  Command="{x:Bind ViewModel.ApplyPresetCommand}" IsEnabled="{x:Bind ViewModel.CanApplyPreset, Mode=OneWay}" />
                </StackPanel></Border>
                <settings:SettingCard x:Uid="DevicesPage017" Glyph="&#xE7F6;" Description="{x:Bind Mixer.MonitorDescription, Mode=OneWay}">
                    <settings:SettingCard.ActionContent><ToggleSwitch x:Uid="DevicesPage018" IsOn="{x:Bind Mixer.IsMonitoring, Mode=TwoWay}" IsEnabled="{x:Bind Mixer.CanToggleMonitor, Mode=OneWay}" /></settings:SettingCard.ActionContent>
                </settings:SettingCard>
                <settings:SettingCard x:Uid="DevicesPage019" Glyph="&#xE7F5;">
                    <settings:SettingCard.ActionContent><ComboBox x:Uid="DevicesPage020" ItemsSource="{x:Bind Mixer.Buses}" DisplayMemberPath="DisplayName" SelectedIndex="{x:Bind Mixer.MonitorBusIndex, Mode=TwoWay}" MinWidth="160" /></settings:SettingCard.ActionContent>
                </settings:SettingCard>
            </StackPanel>
            <StackPanel Spacing="8">
                <TextBlock x:Uid="DevicesPage012"  Style="{StaticResource SubtitleTextBlockStyle}" />
                <settings:SettingCard x:Uid="DevicesPage013"   Glyph="&#xE8F4;">
                    <settings:SettingCard.ActionContent><ToggleSwitch x:Uid="DevicesPage014" IsOn="{x:Bind ViewModel.HideVoicemeeterWindow, Mode=TwoWay}"    /></settings:SettingCard.ActionContent>
                </settings:SettingCard>
                <settings:SettingCard x:Uid="DevicesPage015"   Glyph="&#xE777;">
                    <settings:SettingCard.ActionContent><Button x:Uid="DevicesPage016"  Click="OnRestartEngine" IsEnabled="{x:Bind ViewModel.CanEdit, Mode=OneWay}"  /></settings:SettingCard.ActionContent>
                </settings:SettingCard>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
