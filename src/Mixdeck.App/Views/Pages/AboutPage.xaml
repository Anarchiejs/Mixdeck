<?xml version="1.0" encoding="utf-8"?>
<Page x:Class="Mixdeck.App.Views.Pages.AboutPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer HorizontalScrollMode="Disabled" VerticalScrollBarVisibility="Auto">
        <StackPanel Padding="{StaticResource MixdeckPagePadding}" Spacing="24" MaxWidth="1040" HorizontalAlignment="Stretch">
            <TextBlock x:Uid="AboutPage001" Style="{StaticResource TitleTextBlockStyle}"  />
            <Border Style="{StaticResource MixdeckCardStyle}" Padding="24">
                <Grid ColumnSpacing="24">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <Image x:Uid="AboutPage002" Source="ms-appx:///Assets/Mixdeck-256.png" Width="80" Height="80"  />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                        <TextBlock x:Uid="AboutPage003"  Style="{StaticResource SubtitleTextBlockStyle}" />
                        <TextBlock Text="{x:Bind ViewModel.Version}" IsTextSelectionEnabled="True" />
                        <TextBlock x:Uid="AboutPage004"  TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </Grid>
            </Border>
            <StackPanel Spacing="8">
                <TextBlock x:Uid="AboutPage005"  Style="{StaticResource SubtitleTextBlockStyle}" />
                <Border Style="{StaticResource MixdeckCardStyle}">
                    <StackPanel Spacing="16">
                        <TextBlock Text="{x:Bind ViewModel.Status, Mode=OneWay}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
                        <InfoBar x:Uid="AboutPage006" IsOpen="{x:Bind ViewModel.HasError, Mode=OneWay}" IsClosable="False" Severity="Error"   />
                        <ProgressRing x:Uid="AboutPage007" Width="24" Height="24" HorizontalAlignment="Left" IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}" Visibility="{x:Bind ViewModel.IsBusy, Mode=OneWay}"  />
                        <ProgressBar x:Uid="AboutPage008" Minimum="0" Maximum="100" Value="{x:Bind ViewModel.Progress, Mode=OneWay}" Visibility="{x:Bind ViewModel.IsInstalling, Mode=OneWay}"  />
                        <Button x:Uid="AboutPage009"  Command="{x:Bind ViewModel.CheckCommand}" IsEnabled="{x:Bind ViewModel.CanCheck, Mode=OneWay}" />
                        <Button x:Uid="AboutPage010"  Style="{StaticResource AccentButtonStyle}" Command="{x:Bind ViewModel.InstallCommand}" Visibility="{x:Bind ViewModel.IsAvailable, Mode=OneWay}" IsEnabled="{x:Bind ViewModel.CanInstall, Mode=OneWay}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource MixdeckCardStyle}" Visibility="{x:Bind ViewModel.HasNotes, Mode=OneWay}">
                    <StackPanel Spacing="8">
                        <TextBlock x:Uid="AboutPage011"  Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <TextBlock Text="{x:Bind ViewModel.Notes, Mode=OneWay}" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                    </StackPanel>
                </Border>
            </StackPanel>
            <StackPanel Spacing="8">
                <TextBlock x:Uid="AboutPage012"  Style="{StaticResource SubtitleTextBlockStyle}" />
                <Border Style="{StaticResource MixdeckCardStyle}">
                    <StackPanel Spacing="12">
                        <HyperlinkButton x:Uid="AboutPage013"  NavigateUri="{x:Bind ViewModel.RepositoryUri}" />
                        <HyperlinkButton x:Uid="AboutPage014"  NavigateUri="{x:Bind ViewModel.LicenseUri}" />
                        <TextBlock x:Uid="AboutPage015"  TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock x:Uid="AboutPage016" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
