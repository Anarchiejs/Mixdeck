<?xml version="1.0" encoding="utf-8"?>
<Page x:Class="Mixdeck.App.Views.Pages.AboutPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Language="fr-FR">
    <ScrollViewer HorizontalScrollMode="Disabled" VerticalScrollBarVisibility="Auto">
        <StackPanel Padding="{StaticResource MixdeckPagePadding}" Spacing="24" MaxWidth="1040" HorizontalAlignment="Stretch">
            <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="À propos" />
            <Border Style="{StaticResource MixdeckCardStyle}" Padding="24">
                <Grid ColumnSpacing="24">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <Image Source="ms-appx:///Assets/Mixdeck-256.png" Width="80" Height="80" AutomationProperties.Name="Icône de Mixdeck" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                        <TextBlock Text="Mixdeck" Style="{StaticResource SubtitleTextBlockStyle}" />
                        <TextBlock Text="{x:Bind ViewModel.Version}" IsTextSelectionEnabled="True" />
                        <TextBlock Text="Votre mixage, à portée de main." TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </Grid>
            </Border>
            <StackPanel Spacing="8">
                <TextBlock Text="Mises à jour" Style="{StaticResource SubtitleTextBlockStyle}" />
                <Border Style="{StaticResource MixdeckCardStyle}">
                    <StackPanel Spacing="16">
                        <TextBlock Text="{x:Bind ViewModel.Status, Mode=OneWay}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
                        <InfoBar IsOpen="{x:Bind ViewModel.HasError, Mode=OneWay}" IsClosable="False" Severity="Error" Title="Mise à jour impossible" Message="Vérifiez votre connexion puis réessayez." />
                        <ProgressRing Width="24" Height="24" HorizontalAlignment="Left" IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}" Visibility="{x:Bind ViewModel.IsBusy, Mode=OneWay}" AutomationProperties.Name="Opération de mise à jour en cours" />
                        <ProgressBar Minimum="0" Maximum="100" Value="{x:Bind ViewModel.Progress, Mode=OneWay}" Visibility="{x:Bind ViewModel.IsInstalling, Mode=OneWay}" AutomationProperties.Name="Téléchargement de la mise à jour" />
                        <Button Content="Rechercher" Command="{x:Bind ViewModel.CheckCommand}" IsEnabled="{x:Bind ViewModel.CanCheck, Mode=OneWay}" />
                        <Button Content="Installer et redémarrer" Style="{StaticResource AccentButtonStyle}" Command="{x:Bind ViewModel.InstallCommand}" Visibility="{x:Bind ViewModel.IsAvailable, Mode=OneWay}" IsEnabled="{x:Bind ViewModel.CanInstall, Mode=OneWay}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource MixdeckCardStyle}" Visibility="{x:Bind ViewModel.HasNotes, Mode=OneWay}">
                    <StackPanel Spacing="8">
                        <TextBlock Text="Notes de version" Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <TextBlock Text="{x:Bind ViewModel.Notes, Mode=OneWay}" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                    </StackPanel>
                </Border>
            </StackPanel>
            <StackPanel Spacing="8">
                <TextBlock Text="Projet et mentions légales" Style="{StaticResource SubtitleTextBlockStyle}" />
                <Border Style="{StaticResource MixdeckCardStyle}">
                    <StackPanel Spacing="12">
                        <HyperlinkButton Content="Code source sur GitHub" NavigateUri="{x:Bind ViewModel.RepositoryUri}" />
                        <HyperlinkButton Content="Licence MIT" NavigateUri="{x:Bind ViewModel.LicenseUri}" />
                        <TextBlock Text="Voicemeeter est un produit de VB-Audio ; Mixdeck n’est pas affilié à VB-Audio." TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
