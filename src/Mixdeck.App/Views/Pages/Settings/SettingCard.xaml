<UserControl x:Class="Mixdeck.App.Views.Pages.Settings.SettingCard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border Style="{StaticResource MixdeckCardStyle}" MinHeight="76">
        <Grid ColumnSpacing="16">
            <Grid.ColumnDefinitions><ColumnDefinition Width="24" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <FontIcon Glyph="{x:Bind Glyph, Mode=OneWay}" FontFamily="{StaticResource MixdeckIconFont}" FontSize="20" VerticalAlignment="Center" />
            <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                <TextBlock Text="{x:Bind Title, Mode=OneWay}" TextWrapping="Wrap" />
                <TextBlock Text="{x:Bind Description, Mode=OneWay}" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Style="{StaticResource CaptionTextBlockStyle}" />
            </StackPanel>
            <ContentPresenter Grid.Column="2" Content="{x:Bind ActionContent, Mode=OneWay}" VerticalAlignment="Center" />
        </Grid>
    </Border>
</UserControl>
