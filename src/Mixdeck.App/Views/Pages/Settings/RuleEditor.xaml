<UserControl x:Class="Mixdeck.App.Views.Pages.Settings.RuleEditor"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollMode="Disabled">
        <StackPanel Spacing="16" MinWidth="280" MaxWidth="480" Padding="0,0,4,4">
            <InfoBar x:Uid="RuleEditor001" IsOpen="{x:Bind ViewModel.HasError, Mode=OneWay}" Severity="Error" IsClosable="False"   />
            <TextBox x:Uid="RuleEditor002"   Text="{x:Bind ViewModel.Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" MaxLength="120" />
            <TextBlock x:Uid="RuleEditor003"  Style="{StaticResource BodyStrongTextBlockStyle}" />
            <AutoSuggestBox x:Uid="RuleEditor004"   Text="{x:Bind ViewModel.ProcessName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" TextChanged="OnProcessChanged" SuggestionChosen="OnSuggestionChosen" QueryIcon="Find"  />
            <TextBlock x:Uid="RuleEditor005"  Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <ComboBox x:Uid="RuleEditor006"  SelectedIndex="{x:Bind ViewModel.TriggerIndex, Mode=TwoWay}" HorizontalAlignment="Stretch">
                <ComboBoxItem x:Uid="RuleEditor007"  /><ComboBoxItem x:Uid="RuleEditor008"  />
            </ComboBox>
            <TextBlock x:Uid="RuleEditor009"  Style="{StaticResource BodyStrongTextBlockStyle}" />
            <ComboBox x:Uid="RuleEditor010"  SelectedIndex="{x:Bind ViewModel.ActionIndex, Mode=TwoWay}" HorizontalAlignment="Stretch">
                <ComboBoxItem x:Uid="RuleEditor011"  /><ComboBoxItem x:Uid="RuleEditor012"  /><ComboBoxItem x:Uid="RuleEditor013"  />
            </ComboBox>
            <ComboBox x:Uid="RuleEditor014"   ItemsSource="{x:Bind ViewModel.Mixer.Profiles}" DisplayMemberPath="Name" SelectedItem="{x:Bind ViewModel.SelectedProfile, Mode=TwoWay}" Visibility="{x:Bind ViewModel.IsProfileAction, Mode=OneWay}" HorizontalAlignment="Stretch" />
            <TextBlock x:Uid="RuleEditor015"  TextWrapping="Wrap" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <CheckBox x:Uid="RuleEditor016"  IsChecked="{x:Bind ViewModel.RevertWhenInactive, Mode=TwoWay}" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
