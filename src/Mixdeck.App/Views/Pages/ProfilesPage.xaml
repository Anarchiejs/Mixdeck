<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Mixdeck.App.Views.Pages.ProfilesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:shared="using:Mixdeck.App.ViewModels.Shared"
    xmlns:common="using:Mixdeck.App.Views.Pages.Common">
    <ScrollViewer HorizontalScrollMode="Disabled" VerticalScrollBarVisibility="Auto">
        <StackPanel Padding="{StaticResource MixdeckPagePadding}" Spacing="24">
            <TextBlock x:Uid="ProfilesPage001" Style="{StaticResource TitleTextBlockStyle}"  />
            <TextBlock x:Uid="ProfilesPage002"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" Margin="0,-16,0,0" />
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Click="OnCreateClick" Style="{StaticResource AccentButtonStyle}" IsEnabled="{x:Bind ViewModel.IsIdle, Mode=OneWay}">
                    <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE710;" FontSize="16" /><TextBlock x:Uid="ProfilesPage003"  /></StackPanel>
                </Button>
                <Button x:Uid="ProfilesPage004"  Click="OnImportClick" IsEnabled="{x:Bind ViewModel.IsIdle, Mode=OneWay}" />
            </StackPanel>
            <ProgressBar x:Uid="ProfilesPage005" IsIndeterminate="True" Visibility="{x:Bind ViewModel.IsBusy, Mode=OneWay}"  />
            <InfoBar x:Uid="ProfilesPage006" IsOpen="{x:Bind ViewModel.HasError, Mode=TwoWay}" Visibility="{x:Bind ViewModel.HasError, Mode=OneWay}" Severity="Error"
                     Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}" />
            <Border Style="{StaticResource MixdeckCardStyle}" Visibility="{x:Bind IsEmpty}" Padding="32">
                <StackPanel Spacing="16" HorizontalAlignment="Center" MaxWidth="400">
                    <FontIcon Glyph="&#xE8A5;" FontSize="40" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock x:Uid="ProfilesPage007"  Style="{StaticResource SubtitleTextBlockStyle}" TextAlignment="Center" TextWrapping="Wrap" />
                    <TextBlock x:Uid="ProfilesPage008"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" TextAlignment="Center" />
                    <Button x:Uid="ProfilesPage009"  Click="OnCreateClick" HorizontalAlignment="Center" IsEnabled="{x:Bind ViewModel.IsIdle, Mode=OneWay}" />
                </StackPanel>
            </Border>
            <ItemsRepeater x:Name="ProfileList" ItemsSource="{x:Bind ViewModel.Mixer.Profiles}" ElementPrepared="OnProfilePrepared">
                <ItemsRepeater.Layout><StackLayout Spacing="8" /></ItemsRepeater.Layout>
                <ItemsRepeater.ItemTemplate><DataTemplate x:DataType="shared:ProfileItemViewModel"><common:ProfileCard Item="{x:Bind}" /></DataTemplate></ItemsRepeater.ItemTemplate>
            </ItemsRepeater>
        </StackPanel>
    </ScrollViewer>
</Page>
