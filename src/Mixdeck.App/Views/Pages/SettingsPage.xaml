<?xml version="1.0" encoding="utf-8"?>
<Page x:Class="Mixdeck.App.Views.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Mixdeck.App.Views.Pages.Settings"
    xmlns:vm="using:Mixdeck.App.ViewModels.Pages"
    xmlns:shared="using:Mixdeck.App.ViewModels.Shared"
    Loaded="OnLoaded" Unloaded="OnUnloaded">
    <ScrollViewer HorizontalScrollMode="Disabled" VerticalScrollBarVisibility="Auto">
        <StackPanel Padding="{StaticResource MixdeckPagePadding}" Spacing="24" MaxWidth="1040">
            <StackPanel Spacing="8">
                <TextBlock x:Uid="SettingsPage001"  Style="{StaticResource TitleTextBlockStyle}" />
                <TextBlock Text="{x:Bind ViewModel.SaveStatus, Mode=OneWay}" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" AutomationProperties.LiveSetting="Polite" />
            </StackPanel>
            <InfoBar x:Uid="SettingsPage002" x:Name="PageError" IsOpen="{x:Bind ViewModel.HasError, Mode=OneWay}"  Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}" Severity="Error" IsClosable="False" />
            <StackPanel Spacing="8">
                <TextBlock x:Uid="SettingsPage003"  Style="{StaticResource SubtitleTextBlockStyle}" Margin="0,0,0,4" />
                <local:SettingCard x:Uid="SettingsPage004"   Glyph="&#xE7E8;">
                    <local:SettingCard.ActionContent><ToggleSwitch x:Uid="SettingsPage005" IsOn="{x:Bind ViewModel.StartWithWindows, Mode=TwoWay}"    /></local:SettingCard.ActionContent>
                </local:SettingCard>
                <local:SettingCard x:Uid="SettingsPage006"   Glyph="&#xE768;">
                    <local:SettingCard.ActionContent><ToggleSwitch x:Uid="SettingsPage007" IsOn="{x:Bind ViewModel.AutoLaunchVoicemeeter, Mode=TwoWay}"    /></local:SettingCard.ActionContent>
                </local:SettingCard>
                <local:SettingCard x:Uid="SettingsPage008"   Glyph="&#xE7F4;">
                    <local:SettingCard.ActionContent><ToggleSwitch x:Uid="SettingsPage009" IsOn="{x:Bind ViewModel.ShowOsd, Mode=TwoWay}"    /></local:SettingCard.ActionContent>
                </local:SettingCard>
                <local:SettingCard x:Uid="SettingsPage010"   Glyph="&#xE718;">
                    <local:SettingCard.ActionContent><ToggleSwitch x:Uid="SettingsPage011" IsOn="{x:Bind ViewModel.AlwaysShowTrayIcon, Mode=TwoWay}"    /></local:SettingCard.ActionContent>
                </local:SettingCard>
                <local:SettingCard x:Uid="SettingsPage012"   Glyph="&#xE895;">
                    <local:SettingCard.ActionContent><ToggleSwitch x:Uid="SettingsPage013" IsOn="{x:Bind ViewModel.CheckForUpdates, Mode=TwoWay}"    /></local:SettingCard.ActionContent>
                </local:SettingCard>
            </StackPanel>
            <StackPanel Spacing="8">
                <TextBlock x:Uid="SettingsPage014"  Style="{StaticResource SubtitleTextBlockStyle}" Margin="0,0,0,4" />
                <local:SettingCard x:Uid="SettingsPage015"   Glyph="&#xE790;">
                    <local:SettingCard.ActionContent>
                        <ComboBox x:Uid="SettingsPage016" SelectedIndex="{x:Bind ViewModel.ThemeIndex, Mode=TwoWay}" MinWidth="136" >
                            <ComboBoxItem x:Uid="SettingsPage017"  /><ComboBoxItem x:Uid="SettingsPage018"  /><ComboBoxItem x:Uid="SettingsPage019"  />
                        </ComboBox>
                    </local:SettingCard.ActionContent>
                </local:SettingCard>
                <local:SettingCard x:Uid="SettingsPage020"   Glyph="&#xE774;">
                    <local:SettingCard.ActionContent>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <ComboBox x:Uid="SettingsPage021" SelectedIndex="{x:Bind ViewModel.LanguageIndex, Mode=TwoWay}" MinWidth="136" >
                                <ComboBoxItem x:Uid="SettingsPage022"  /><ComboBoxItem x:Uid="SettingsPage023"  /><ComboBoxItem x:Uid="SettingsPage024"  />
                            </ComboBox>
                            <Button x:Uid="SettingsPage025"  Command="{x:Bind ViewModel.RestartCommand}" />
                        </StackPanel>
                    </local:SettingCard.ActionContent>
                </local:SettingCard>
                <Border Style="{StaticResource MixdeckCardStyle}">
                    <StackPanel Spacing="12">
                        <TextBlock x:Uid="SettingsPage026"  Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <TextBlock Text="{x:Bind ViewModel.AccentSummary, Mode=OneWay}" TextWrapping="Wrap" />
                        <TextBlock x:Uid="SettingsPage027"  TextWrapping="Wrap" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button x:Uid="SettingsPage028"  Click="OnWindowsAccent" />
                            <Button x:Uid="SettingsPage029"  Click="OnCustomAccent" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
            <StackPanel Spacing="8">
                <TextBlock x:Uid="SettingsPage030"  Style="{StaticResource SubtitleTextBlockStyle}" Margin="0,0,0,4" />
                <Border Style="{StaticResource MixdeckCardStyle}">
                    <StackPanel Spacing="8">
                        <TextBlock x:Uid="SettingsPage031"  TextWrapping="Wrap" />
                        <ComboBox x:Uid="SettingsPage032" ItemsSource="{x:Bind ViewModel.Mixer.Strips}" DisplayMemberPath="DisplayName" SelectedIndex="{x:Bind ViewModel.MicStripIndex, Mode=TwoWay}" HorizontalAlignment="Stretch"  />
                    </StackPanel>
                </Border>
                <local:SettingCard x:Uid="SettingsPage033"   Glyph="&#xE720;">
                    <local:SettingCard.ActionContent><ToggleSwitch x:Uid="SettingsPage034" IsOn="{x:Bind ViewModel.ShowMicBadge, Mode=TwoWay}"    /></local:SettingCard.ActionContent>
                </local:SettingCard>
                <local:SettingCard x:Uid="SettingsPage035"   Glyph="&#xE767;">
                    <local:SettingCard.ActionContent><ToggleSwitch x:Uid="SettingsPage036" IsOn="{x:Bind ViewModel.PlayMicSounds, Mode=TwoWay}"    /></local:SettingCard.ActionContent>
                </local:SettingCard>
            </StackPanel>
            <StackPanel Spacing="8">
                <TextBlock x:Uid="SettingsPage037"  Style="{StaticResource SubtitleTextBlockStyle}" Margin="0,0,0,4" />
                <local:SettingCard x:Uid="SettingsPage038"   Glyph="&#xE8F1;">
                    <local:SettingCard.ActionContent><ComboBox x:Uid="SettingsPage039" ItemsSource="{x:Bind ViewModel.ProfileChoices}" DisplayMemberPath="Name" SelectedItem="{x:Bind ViewModel.StartupProfile, Mode=TwoWay}" MinWidth="160" MaxWidth="280"  /></local:SettingCard.ActionContent>
                </local:SettingCard>
                <Border Style="{StaticResource MixdeckCardStyle}">
                    <StackPanel Spacing="8">
                        <Grid><TextBlock x:Uid="SettingsPage040"  /><TextBlock Text="{x:Bind ViewModel.FadeText, Mode=OneWay}" HorizontalAlignment="Right" Style="{StaticResource BodyStrongTextBlockStyle}" /></Grid>
                        <Slider x:Uid="SettingsPage041" Minimum="0" Maximum="2000" StepFrequency="50" SmallChange="50" LargeChange="250" Value="{x:Bind ViewModel.FadeMilliseconds, Mode=TwoWay}" IsThumbToolTipEnabled="False"  />
                        <TextBlock x:Uid="SettingsPage042"  TextWrapping="Wrap" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </Border>
            </StackPanel>
            <StackPanel Spacing="8">
                <TextBlock x:Uid="SettingsPage043"  Style="{StaticResource SubtitleTextBlockStyle}" />
                <local:SettingCard x:Uid="SettingsPage044"   Glyph="&#xE993;">
                    <local:SettingCard.ActionContent><ToggleSwitch x:Uid="SettingsPage045" IsOn="{x:Bind ViewModel.DuckingEnabled, Mode=TwoWay}"    /></local:SettingCard.ActionContent>
                </local:SettingCard>
                <Border Style="{StaticResource MixdeckCardStyle}"><StackPanel Spacing="16">
                    <ComboBox x:Uid="SettingsPage046"  ItemsSource="{x:Bind ViewModel.Mixer.Strips}" DisplayMemberPath="DisplayName" SelectedIndex="{x:Bind ViewModel.DuckingSourceStrip, Mode=TwoWay}" HorizontalAlignment="Stretch"  />
                    <ComboBox x:Uid="SettingsPage047"  ItemsSource="{x:Bind ViewModel.Mixer.Strips}" DisplayMemberPath="DisplayName" SelectedIndex="{x:Bind ViewModel.DuckingTargetStrip, Mode=TwoWay}" HorizontalAlignment="Stretch"  />
                    <TextBlock x:Uid="SettingsPage048"  TextWrapping="Wrap" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <StackPanel Spacing="4">
                        <TextBlock x:Uid="SettingsPage049"  Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <TextBlock Text="{x:Bind ViewModel.DuckingThresholdText, Mode=OneWay}" />
                        <Slider x:Uid="SettingsPage050" Minimum="-60" Maximum="-6" StepFrequency="1" Value="{x:Bind ViewModel.DuckingThresholdDb, Mode=TwoWay}" IsThumbToolTipEnabled="False"  />
                    </StackPanel>
                    <StackPanel Spacing="4">
                        <TextBlock x:Uid="SettingsPage051"  Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <TextBlock Text="{x:Bind ViewModel.DuckingAmountText, Mode=OneWay}" />
                        <Slider x:Uid="SettingsPage052" Minimum="-40" Maximum="-1" StepFrequency="1" Value="{x:Bind ViewModel.DuckingAmountDb, Mode=TwoWay}" IsThumbToolTipEnabled="False"  />
                    </StackPanel>
                    <StackPanel Spacing="4">
                        <TextBlock x:Uid="SettingsPage053"  Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <TextBlock Text="{x:Bind ViewModel.DuckingHoldText, Mode=OneWay}" />
                        <Slider x:Uid="SettingsPage054" Minimum="100" Maximum="3000" StepFrequency="50" Value="{x:Bind ViewModel.DuckingHoldMilliseconds, Mode=TwoWay}" IsThumbToolTipEnabled="False"  />
                    </StackPanel>
                </StackPanel></Border>
            </StackPanel>
            <StackPanel Spacing="8">
                <TextBlock x:Uid="SettingsPage055"  Style="{StaticResource SubtitleTextBlockStyle}" Margin="0,0,0,4" />
                <TextBlock x:Uid="SettingsPage056"  TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="0,0,0,4" />
                <ItemsRepeater ItemsSource="{x:Bind ViewModel.Hotkeys}">
                    <ItemsRepeater.Layout><StackLayout Spacing="8" /></ItemsRepeater.Layout>
                    <ItemsRepeater.ItemTemplate>
                        <DataTemplate x:DataType="vm:HotkeyRowViewModel">
                            <Border Style="{StaticResource MixdeckCardStyle}" Padding="16">
                                <StackPanel Spacing="12">
                                    <TextBlock Text="{x:Bind Name}" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <TextBlock Text="{x:Bind Combination, Mode=OneWay}" VerticalAlignment="Center" TextWrapping="Wrap" />
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                                            <Button x:Uid="SettingsPage057"  Click="OnEditHotkey" AutomationProperties.Name="{x:Bind EditLabel}" />
                                            <Button x:Uid="SettingsPage058"  Click="OnClearHotkey" IsEnabled="{x:Bind HasBinding, Mode=OneWay}" AutomationProperties.Name="{x:Bind ClearLabel}" />
                                        </StackPanel>
                                    </Grid>
                                    <InfoBar x:Uid="SettingsPage059" IsOpen="{x:Bind HasConflict, Mode=OneWay}" IsClosable="False" Severity="Warning"   />
                                    <ComboBox x:Uid="SettingsPage060"  ItemsSource="{x:Bind ProfileChoices}" DisplayMemberPath="Name" SelectedItem="{x:Bind TargetProfile, Mode=TwoWay}" Visibility="{x:Bind IsApplyProfile}" IsEnabled="{x:Bind HasBinding, Mode=OneWay}" HorizontalAlignment="Stretch"  />
                                    <TextBlock Text="{x:Bind DawTarget, Mode=OneWay}" Visibility="{x:Bind IsDaw}" TextWrapping="Wrap" />
                                    <Grid ColumnSpacing="16" Visibility="{x:Bind IsVolume}">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                        <ComboBox x:Uid="SettingsPage061" IsEnabled="{x:Bind HasBinding, Mode=OneWay}"  ItemsSource="{x:Bind Mixer.Buses}" DisplayMemberPath="DisplayName" SelectedIndex="{x:Bind TargetBus, Mode=TwoWay}" HorizontalAlignment="Stretch"  />
                                        <NumberBox x:Uid="SettingsPage062" IsEnabled="{x:Bind HasBinding, Mode=OneWay}" Grid.Column="1"  Minimum="0.1" Maximum="12" SmallChange="0.5" LargeChange="2" NumberFormatter="{x:Bind StepFormatter}" SpinButtonPlacementMode="Compact" Value="{x:Bind StepDb, Mode=TwoWay}"  />
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsRepeater.ItemTemplate>
                </ItemsRepeater>
            </StackPanel>
            <StackPanel Spacing="8">
                <TextBlock x:Uid="SettingsPage063"  Style="{StaticResource SubtitleTextBlockStyle}" Margin="0,0,0,4" />
                <local:SettingCard x:Uid="SettingsPage064"   Glyph="&#xE995;">
                    <local:SettingCard.ActionContent><ToggleSwitch x:Uid="SettingsPage065" IsOn="{x:Bind ViewModel.ShowAppVolumes, Mode=TwoWay}"    /></local:SettingCard.ActionContent>
                </local:SettingCard>
                <TextBlock x:Uid="SettingsPage066"  TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <TextBlock x:Uid="SettingsPage067"  Style="{StaticResource BodyStrongTextBlockStyle}" Margin="0,8,0,0" />
                <ItemsRepeater ItemsSource="{x:Bind ViewModel.Mixer.Strips}">
                    <ItemsRepeater.Layout><StackLayout Spacing="4" /></ItemsRepeater.Layout>
                    <ItemsRepeater.ItemTemplate><DataTemplate x:DataType="shared:StripViewModel">
                        <local:SettingCard Title="{x:Bind DisplayName, Mode=OneWay}" Description="{x:Bind KindText}" Glyph="{x:Bind Icon, Mode=OneWay}">
                            <local:SettingCard.ActionContent><ToggleSwitch x:Uid="SettingsPage068" IsOn="{x:Bind ShowInFlyout, Mode=TwoWay}" Toggled="OnVisibilityToggled"   AutomationProperties.Name="{x:Bind DisplayName, Mode=OneWay}" /></local:SettingCard.ActionContent>
                        </local:SettingCard>
                    </DataTemplate></ItemsRepeater.ItemTemplate>
                </ItemsRepeater>
                <TextBlock x:Uid="SettingsPage069"  Style="{StaticResource BodyStrongTextBlockStyle}" Margin="0,8,0,0" />
                <ItemsRepeater ItemsSource="{x:Bind ViewModel.Mixer.Buses}">
                    <ItemsRepeater.Layout><StackLayout Spacing="4" /></ItemsRepeater.Layout>
                    <ItemsRepeater.ItemTemplate><DataTemplate x:DataType="shared:BusViewModel">
                        <local:SettingCard Title="{x:Bind DisplayName, Mode=OneWay}" Description="{x:Bind KindText}" Glyph="{x:Bind Icon, Mode=OneWay}">
                            <local:SettingCard.ActionContent><ToggleSwitch x:Uid="SettingsPage070" IsOn="{x:Bind ShowInFlyout, Mode=TwoWay}" Toggled="OnVisibilityToggled"   AutomationProperties.Name="{x:Bind DisplayName, Mode=OneWay}" /></local:SettingCard.ActionContent>
                        </local:SettingCard>
                    </DataTemplate></ItemsRepeater.ItemTemplate>
                </ItemsRepeater>
            </StackPanel>
            <StackPanel Spacing="8">
                <TextBlock x:Uid="SettingsPage071"  Style="{StaticResource SubtitleTextBlockStyle}" Margin="0,0,0,4" />
                <local:SettingCard x:Uid="SettingsPage072"   Glyph="&#xE8A5;">
                    <local:SettingCard.ActionContent><Button x:Uid="SettingsPage073"  Command="{x:Bind ViewModel.OpenLogsCommand}"  /></local:SettingCard.ActionContent>
                </local:SettingCard>
                <Border Style="{StaticResource MixdeckCardStyle}">
                    <StackPanel Spacing="12">
                        <TextBlock x:Uid="SettingsPage080"  Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <TextBlock Text="{x:Bind ViewModel.DataPath}" TextWrapping="Wrap" IsTextSelectionEnabled="True" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <Button x:Uid="SettingsPage081"  Command="{x:Bind ViewModel.CopyDataPathCommand}" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
