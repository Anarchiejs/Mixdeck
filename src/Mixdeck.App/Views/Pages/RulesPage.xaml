<?xml version="1.0" encoding="utf-8"?>
<Page x:Class="Mixdeck.App.Views.Pages.RulesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Mixdeck.App.ViewModels.Pages"
    Loaded="OnLoaded">
    <ScrollViewer HorizontalScrollMode="Disabled" VerticalScrollBarVisibility="Auto">
        <StackPanel Padding="{StaticResource MixdeckPagePadding}" Spacing="24" MaxWidth="1040">
            <StackPanel Spacing="8">
                <TextBlock x:Uid="RulesPage001" Style="{StaticResource TitleTextBlockStyle}"  />
                <TextBlock x:Uid="RulesPage002"  TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>
            <InfoBar x:Uid="RulesPage003" x:Name="PageError" IsOpen="{x:Bind ViewModel.HasError, Mode=OneWay}" Visibility="{x:Bind ViewModel.HasError, Mode=OneWay}" Severity="Error" IsClosable="False"   />
            <ProgressBar x:Uid="RulesPage004" IsIndeterminate="True" Visibility="{x:Bind ViewModel.IsBusy, Mode=OneWay}"  />
            <StackPanel Spacing="16">
                <Button Click="OnCreate" Style="{StaticResource AccentButtonStyle}" Visibility="{x:Bind ViewModel.HasRules, Mode=OneWay}">
                    <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE710;" FontSize="16" /><TextBlock x:Uid="RulesPage005"  /></StackPanel>
                </Button>
                <Border Style="{StaticResource MixdeckCardStyle}" Padding="32" Visibility="{x:Bind ViewModel.IsEmpty, Mode=OneWay}">
                    <StackPanel Spacing="16" HorizontalAlignment="Center" MaxWidth="440">
                        <FontIcon Glyph="&#xE945;" FontSize="40" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                        <TextBlock x:Uid="RulesPage006"  Style="{StaticResource SubtitleTextBlockStyle}" TextWrapping="Wrap" TextAlignment="Center" />
                        <TextBlock x:Uid="RulesPage007"  TextWrapping="Wrap" TextAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <Button x:Uid="RulesPage008"  Click="OnCreate" Style="{StaticResource AccentButtonStyle}" HorizontalAlignment="Center" />
                    </StackPanel>
                </Border>
                <TextBlock x:Uid="RulesPage009"  TextWrapping="Wrap" Visibility="{x:Bind ViewModel.HasRules, Mode=OneWay}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <ItemsRepeater ItemsSource="{x:Bind ViewModel.Rules}">
                    <ItemsRepeater.Layout><StackLayout Spacing="8" /></ItemsRepeater.Layout>
                    <ItemsRepeater.ItemTemplate>
                        <DataTemplate x:DataType="vm:RuleCardViewModel">
                            <Border Style="{StaticResource MixdeckCardStyle}" Padding="20,16">
                                <StackPanel Spacing="12">
                                    <Grid ColumnSpacing="16">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <StackPanel Spacing="4" VerticalAlignment="Center">
                                            <TextBlock Text="{x:Bind Name, Mode=OneWay}" Style="{StaticResource BodyStrongTextBlockStyle}" TextWrapping="Wrap" />
                                            <TextBlock Text="{x:Bind Position, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        </StackPanel>
                                        <ToggleSwitch x:Uid="RulesPage010" Grid.Column="1"    IsOn="{x:Bind Enabled, Mode=TwoWay}" AutomationProperties.Name="{x:Bind Name, Mode=OneWay}" />
                                    </Grid>
                                    <TextBlock TextWrapping="Wrap" AutomationProperties.Name="{x:Bind Sentence, Mode=OneWay}"><Run x:Uid="RulesPage011"  /><Run Text="{x:Bind ProcessName, Mode=OneWay}" FontWeight="SemiBold" /><Run Text=" " /><Run Text="{x:Bind TriggerText, Mode=OneWay}" /><Run Text=" → " /><Run Text="{x:Bind ActionText, Mode=OneWay}" FontWeight="SemiBold" /></TextBlock>
                                    <CheckBox x:Uid="RulesPage012"  IsChecked="{x:Bind RevertWhenInactive, Mode=TwoWay}" />
                                    <Grid ColumnSpacing="8">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <Button x:Uid="RulesPage013"  Click="OnEdit" />
                                            <Button x:Uid="RulesPage014"  Click="OnDelete" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4">
                                            <Button x:Uid="RulesPage015" Click="OnMoveUp" IsEnabled="{x:Bind CanMoveUp, Mode=OneWay}"  ><FontIcon FontSize="16" Glyph="&#xE74A;" /></Button>
                                            <Button x:Uid="RulesPage016" Click="OnMoveDown" IsEnabled="{x:Bind CanMoveDown, Mode=OneWay}"  ><FontIcon FontSize="16" Glyph="&#xE74B;" /></Button>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsRepeater.ItemTemplate>
                </ItemsRepeater>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
