<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Mixdeck.App.Views.Pages.MixerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Mixdeck.App.Controls"
    xmlns:common="using:Mixdeck.App.Views.Pages.Common"
    xmlns:shared="using:Mixdeck.App.ViewModels.Shared">
    <ScrollViewer HorizontalScrollMode="Disabled" VerticalScrollBarVisibility="Auto">
        <StackPanel Padding="{StaticResource MixdeckPagePadding}" Spacing="24">
            <TextBlock x:Uid="MixerPage001" Style="{StaticResource TitleTextBlockStyle}"  />
            <TextBlock x:Uid="MixerPage002"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" Margin="0,-16,0,0" />
            <InfoBar x:Uid="MixerPage003" IsOpen="{x:Bind ViewModel.HasError, Mode=TwoWay}" Visibility="{x:Bind ViewModel.HasError, Mode=OneWay}" Severity="Error"
                 Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}" />
            <InfoBar x:Uid="MixerPage004" IsOpen="{x:Bind ViewModel.Mixer.HasCustomizationError, Mode=TwoWay}" Visibility="{x:Bind ViewModel.Mixer.HasCustomizationError, Mode=OneWay}" Severity="Error"
                 Message="{x:Bind ViewModel.Mixer.CustomizationErrorMessage}" />
            <InfoBar IsOpen="{x:Bind shared:Converters.Not(ViewModel.Mixer.IsConnected), Mode=OneWay}" Visibility="{x:Bind ViewModel.Mixer.IsDisconnected, Mode=OneWay}"
                IsClosable="False" Severity="Warning" Title="{x:Bind ViewModel.Mixer.ConnectionTitle, Mode=OneWay}"
                Message="{x:Bind ViewModel.Mixer.ConnectionMessage, Mode=OneWay}">
                <InfoBar.ActionButton>
                    <Button x:Uid="MixerPage005"  Command="{x:Bind ViewModel.LaunchVoicemeeterCommand}"
                        Visibility="{x:Bind ViewModel.Mixer.CanLaunchVoicemeeter, Mode=OneWay}" />
                </InfoBar.ActionButton>
            </InfoBar>
            <StackPanel Spacing="8" Visibility="{x:Bind HasProfiles}">
                <TextBlock x:Uid="MixerPage006"  Style="{StaticResource BodyStrongTextBlockStyle}" />
                <controls:ProfilePillList x:Uid="MixerPage007" ItemsSource="{x:Bind ViewModel.Mixer.Profiles}"
                    SelectedItem="{x:Bind ViewModel.Mixer.ActiveProfile, Mode=OneWay}" ItemInvoked="OnProfileInvoked"
                     />
            </StackPanel>
            <!-- Entrées puis sorties utilisées : les tranches passent à la ligne, la page ne défile que verticalement.
                 Le bouton + rajoute une tranche masquée (sans périphérique ou masquée par l’utilisateur). -->
            <StackPanel Spacing="12">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock x:Uid="MixerPage008" Style="{StaticResource SubtitleTextBlockStyle}" VerticalAlignment="Center" />
                    <Button x:Uid="MixerPage011" Width="32" Height="32" Padding="0" VerticalAlignment="Center" Click="OnAddStripClick"
                        Style="{StaticResource SubtleButtonStyle}" Visibility="{x:Bind ViewModel.Mixer.HasHiddenStrips, Mode=OneWay}">
                        <FontIcon Glyph="&#xE710;" FontSize="14" />
                    </Button>
                </StackPanel>
                <ItemsControl ItemsSource="{x:Bind ViewModel.Mixer.ConsoleStrips}" IsTabStop="False">
                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><controls:WrapPanel Spacing="12" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate><DataTemplate x:DataType="shared:StripViewModel"><common:ChannelCard Model="{x:Bind}" /></DataTemplate></ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
            <StackPanel Spacing="12">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock x:Uid="MixerPage009" Style="{StaticResource SubtitleTextBlockStyle}" VerticalAlignment="Center" />
                    <Button x:Uid="MixerPage012" Width="32" Height="32" Padding="0" VerticalAlignment="Center" Click="OnAddBusClick"
                        Style="{StaticResource SubtleButtonStyle}" Visibility="{x:Bind ViewModel.Mixer.HasHiddenBuses, Mode=OneWay}">
                        <FontIcon Glyph="&#xE710;" FontSize="14" />
                    </Button>
                </StackPanel>
                <ItemsControl ItemsSource="{x:Bind ViewModel.Mixer.ConsoleBuses}" IsTabStop="False">
                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><controls:WrapPanel Spacing="12" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate><DataTemplate x:DataType="shared:BusViewModel"><common:ChannelCard Model="{x:Bind}" /></DataTemplate></ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
            <TextBlock x:Uid="MixerPage010"
                TextWrapping="Wrap" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </StackPanel>
    </ScrollViewer>
</Page>
