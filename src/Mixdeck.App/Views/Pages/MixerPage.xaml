<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Mixdeck.App.Views.Pages.MixerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Mixdeck.App.Controls"
    xmlns:common="using:Mixdeck.App.Views.Pages.Common"
    xmlns:shared="using:Mixdeck.App.ViewModels.Shared">
    <ScrollViewer HorizontalScrollMode="Disabled" VerticalScrollBarVisibility="Auto">
        <StackPanel Padding="{StaticResource MixdeckPagePadding}" Spacing="24">
            <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="Console" />
            <TextBlock Text="Un seul endroit pour régler tes entrées, tes sorties et ton mixage."
                Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" Margin="0,-16,0,0" />
            <InfoBar IsOpen="{x:Bind ViewModel.HasError, Mode=TwoWay}" Severity="Error"
                Title="Opération impossible" Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}" />
            <InfoBar IsOpen="{x:Bind shared:Converters.Not(ViewModel.Mixer.IsConnected), Mode=OneWay}"
                IsClosable="False" Severity="Warning" Title="{x:Bind ViewModel.Mixer.ConnectionTitle, Mode=OneWay}"
                Message="{x:Bind ViewModel.Mixer.ConnectionMessage, Mode=OneWay}">
                <InfoBar.ActionButton>
                    <Button Content="Lancer Voicemeeter" Command="{x:Bind ViewModel.LaunchVoicemeeterCommand}"
                        Visibility="{x:Bind ViewModel.Mixer.CanLaunchVoicemeeter, Mode=OneWay}" />
                </InfoBar.ActionButton>
            </InfoBar>
            <StackPanel Spacing="8" Visibility="{x:Bind HasProfiles}">
                <TextBlock Text="Profils" Style="{StaticResource BodyStrongTextBlockStyle}" />
                <controls:ProfilePillList ItemsSource="{x:Bind ViewModel.Mixer.Profiles}"
                    SelectedItem="{x:Bind ViewModel.Mixer.ActiveProfile, Mode=OneWay}" ItemInvoked="OnProfileInvoked"
                    AutomationProperties.Name="Appliquer un profil" />
            </StackPanel>
            <ScrollViewer HorizontalScrollBarVisibility="Auto" HorizontalScrollMode="Enabled" VerticalScrollBarVisibility="Disabled" VerticalScrollMode="Disabled">
                <StackPanel Orientation="Horizontal" Spacing="16">
                    <StackPanel Spacing="12">
                        <TextBlock Text="Entrées" Style="{StaticResource SubtitleTextBlockStyle}" />
                        <ItemsRepeater ItemsSource="{x:Bind ViewModel.Mixer.Strips}">
                            <ItemsRepeater.Layout><StackLayout Orientation="Horizontal" Spacing="8" /></ItemsRepeater.Layout>
                            <ItemsRepeater.ItemTemplate><DataTemplate x:DataType="shared:StripViewModel"><common:ChannelCard Model="{x:Bind}" /></DataTemplate></ItemsRepeater.ItemTemplate>
                        </ItemsRepeater>
                    </StackPanel>
                    <Border Width="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" Margin="0,44,0,0" />
                    <StackPanel Spacing="12">
                        <TextBlock Text="Sorties" Style="{StaticResource SubtitleTextBlockStyle}" />
                        <ItemsRepeater ItemsSource="{x:Bind ViewModel.Mixer.Buses}">
                            <ItemsRepeater.Layout><StackLayout Orientation="Horizontal" Spacing="8" /></ItemsRepeater.Layout>
                            <ItemsRepeater.ItemTemplate><DataTemplate x:DataType="shared:BusViewModel"><common:ChannelCard Model="{x:Bind}" /></DataTemplate></ItemsRepeater.ItemTemplate>
                        </ItemsRepeater>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
            <TextBlock Text="Double-clique sur un fader pour revenir à 0 dB, ou sur le panoramique pour le centrer. F2 sur un nom permet de le modifier."
                TextWrapping="Wrap" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </StackPanel>
    </ScrollViewer>
</Page>
