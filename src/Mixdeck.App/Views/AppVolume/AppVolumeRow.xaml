<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Mixdeck.App.Views.AppVolume.AppVolumeRow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Mixdeck.App.Controls"
    xmlns:local="using:Mixdeck.App.Views.AppVolume">
    <Grid Margin="0,0,0,4" Padding="8,6,4,6" ColumnSpacing="10"
          Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
          BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
          CornerRadius="{StaticResource MixdeckCardCornerRadius}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="24" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Grid VerticalAlignment="Center" Width="24" Height="24">
            <FontIcon FontFamily="{StaticResource MixdeckIconFont}" FontSize="18" Glyph="&#xE8D6;" />
            <Image Source="{x:Bind Session.Icon, Mode=OneWay}" Stretch="Uniform" />
        </Grid>
        <StackPanel Grid.Column="1" Spacing="2">
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{x:Bind Session.DisplayName, Mode=OneWay}" TextTrimming="CharacterEllipsis"
                           Style="{StaticResource BodyTextBlockStyle}" />
                <TextBlock Grid.Column="1" Text="{x:Bind Session.VolumeLabel, Mode=OneWay}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           Style="{StaticResource CaptionTextBlockStyle}" />
            </Grid>
            <local:AppVolumeSlider Minimum="0" Maximum="100" StepFrequency="1" SmallChange="2" LargeChange="10"
                    MinHeight="24" Value="{x:Bind Session.Volume, Mode=TwoWay}"
                    AutomationProperties.Name="{x:Bind Session.DisplayName, Mode=OneWay}" />
        </StackPanel>
        <controls:MuteToggle Grid.Column="2" VerticalAlignment="Center"
                             IsChecked="{x:Bind Session.IsMuted, Mode=TwoWay}"
                             AutomationProperties.Name="{x:Bind Session.MuteLabel, Mode=OneWay}" />
        <Button x:Uid="AppVolumeRow001" Grid.Column="3" VerticalAlignment="Center" Padding="4" Click="OnRouteClick"
                Visibility="{x:Bind local:AppVolumeList.ToVisibility(Session.CanRoute), Mode=OneWay}"
                 >
            <FontIcon FontFamily="{StaticResource MixdeckIconFont}" Glyph="&#xE712;" FontSize="16" />
        </Button>
    </Grid>
</UserControl>
