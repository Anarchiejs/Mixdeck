<?xml version="1.0" encoding="utf-8"?>
<!-- Jetons de design partagés : espacements, rayons, couleurs sémantiques. Propriété de l'intégrateur. -->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Default">
            <Color x:Key="MixdeckMeterLowColor">#FF3FB950</Color>
            <Color x:Key="MixdeckMeterMidColor">#FFE3B341</Color>
            <Color x:Key="MixdeckMeterClipColor">#FFF85149</Color>
            <Color x:Key="MixdeckMeterTrackColor">#1FFFFFFF</Color>
            <Color x:Key="MixdeckMutedColor">#FFE5484D</Color>
            <SolidColorBrush x:Key="MixdeckMutedBrush" Color="{StaticResource MixdeckMutedColor}" />
            <SolidColorBrush x:Key="MixdeckCardBackgroundBrush" Color="#0DFFFFFF" />
            <SolidColorBrush x:Key="MixdeckCardBorderBrush" Color="#19FFFFFF" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Light">
            <Color x:Key="MixdeckMeterLowColor">#FF1A7F37</Color>
            <Color x:Key="MixdeckMeterMidColor">#FFB08800</Color>
            <Color x:Key="MixdeckMeterClipColor">#FFCF222E</Color>
            <Color x:Key="MixdeckMeterTrackColor">#14000000</Color>
            <Color x:Key="MixdeckMutedColor">#FFC4314B</Color>
            <SolidColorBrush x:Key="MixdeckMutedBrush" Color="{StaticResource MixdeckMutedColor}" />
            <SolidColorBrush x:Key="MixdeckCardBackgroundBrush" Color="#B3FFFFFF" />
            <SolidColorBrush x:Key="MixdeckCardBorderBrush" Color="#0F000000" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="HighContrast">
            <Color x:Key="MixdeckMeterLowColor">#FF00FF00</Color>
            <Color x:Key="MixdeckMeterMidColor">#FFFFFF00</Color>
            <Color x:Key="MixdeckMeterClipColor">#FFFF0000</Color>
            <Color x:Key="MixdeckMeterTrackColor">#FF000000</Color>
            <Color x:Key="MixdeckMutedColor">#FFFF0000</Color>
            <SolidColorBrush x:Key="MixdeckMutedBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="MixdeckCardBackgroundBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="MixdeckCardBorderBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>

    <!-- Espacements : grille de 4 px. -->
    <x:Double x:Key="MixdeckSpacingXS">4</x:Double>
    <x:Double x:Key="MixdeckSpacingS">8</x:Double>
    <x:Double x:Key="MixdeckSpacingM">12</x:Double>
    <x:Double x:Key="MixdeckSpacingL">16</x:Double>
    <x:Double x:Key="MixdeckSpacingXL">24</x:Double>
    <Thickness x:Key="MixdeckPagePadding">36,24,36,36</Thickness>
    <Thickness x:Key="MixdeckCardPadding">16,12,16,12</Thickness>
    <CornerRadius x:Key="MixdeckCardCornerRadius">8</CornerRadius>
    <CornerRadius x:Key="MixdeckFlyoutCornerRadius">8</CornerRadius>

    <!-- Polices : Segoe UI Variable (défaut WinUI), Segoe Fluent Icons pour les glyphes. -->
    <FontFamily x:Key="MixdeckIconFont">Segoe Fluent Icons,Segoe MDL2 Assets</FontFamily>

    <Style x:Key="MixdeckCardStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource MixdeckCardCornerRadius}" />
        <Setter Property="Padding" Value="{StaticResource MixdeckCardPadding}" />
    </Style>
</ResourceDictionary>
