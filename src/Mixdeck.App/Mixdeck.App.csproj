<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <RootNamespace>Mixdeck.App</RootNamespace>
    <AssemblyName>Mixdeck</AssemblyName>
    <UseWinUI>true</UseWinUI>
    <DefaultLanguage>fr-FR</DefaultLanguage>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- Appli non empaquetée (installée par Velopack), Windows App SDK embarqué. -->
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <!-- Indispensable pour que dotnet publish copie Mixdeck.pri (XAML compilé) dans une appli non empaquetée. -->
    <EnableMsixTooling>true</EnableMsixTooling>
    <Platforms>x64</Platforms>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\Mixdeck.ico</ApplicationIcon>
    <!-- Program.Main personnalisé : instance unique + hôte générique. -->
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" />
    <PackageReference Include="Microsoft.Graphics.Win2D" />
    <PackageReference Include="H.NotifyIcon.WinUI" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="Serilog.Extensions.Hosting" />
    <PackageReference Include="Serilog.Sinks.File" />
    <PackageReference Include="Velopack" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Mixdeck.Core\Mixdeck.Core.csproj" />
    <ProjectReference Include="..\Mixdeck.Voicemeeter\Mixdeck.Voicemeeter.csproj" />
    <ProjectReference Include="..\Mixdeck.Platform\Mixdeck.Platform.csproj" />
    <ProjectReference Include="..\Mixdeck.FlStudio\Mixdeck.FlStudio.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="Assets\**\*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
