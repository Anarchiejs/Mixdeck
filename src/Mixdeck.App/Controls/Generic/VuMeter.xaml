<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="using:Mixdeck.App.Controls" xmlns:canvas="using:Microsoft.Graphics.Canvas.UI.Xaml">
  <Style TargetType="local:VuMeter">
    <Setter Property="IsTabStop" Value="False" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="local:VuMeter">
          <Grid x:Name="PART_CanvasHost"><canvas:CanvasControl x:Name="PART_Canvas" IsHitTestVisible="False" /></Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
</ResourceDictionary>
