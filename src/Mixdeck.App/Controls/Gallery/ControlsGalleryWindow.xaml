<Window x:Class="Mixdeck.App.Controls.Gallery.ControlsGalleryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="using:Mixdeck.App.Controls" >
    <Window.SystemBackdrop><MicaBackdrop /></Window.SystemBackdrop>
    <Grid x:Name="Root" Padding="24" RowSpacing="16">
        <Grid.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries>
            <ResourceDictionary Source="ms-appx:///Controls/Controls.xaml"/>
        </ResourceDictionary.MergedDictionaries></ResourceDictionary></Grid.Resources>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <StackPanel Orientation="Horizontal" Spacing="24">
            <TextBlock x:Uid="ControlsGalleryWindow002"  Style="{StaticResource TitleTextBlockStyle}"/>
            <ToggleSwitch x:Uid="ControlsGalleryWindow003"  Toggled="ThemeChanged"/>
            <ToggleSwitch x:Uid="ControlsGalleryWindow004"  IsOn="True" Toggled="AnimationChanged"/>
        </StackPanel>
        <ScrollViewer Grid.Row="1">
            <StackPanel Spacing="20">
                <local:ChannelHeader x:Uid="ControlsGalleryWindow005"  NameCommitted="NameCommitted"/>
                <TextBlock x:Uid="ControlsGalleryWindow006" x:Name="CommittedName" />
                <local:ProfilePillList x:Name="Profiles" ItemInvoked="ProfileInvoked"/>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <local:ProfilePill x:Uid="ControlsGalleryWindow007"  Icon="&#xE7FC;" Color="#C586C0" IsActive="True"/>
                    <local:RouteButton Bus="A1" IsChecked="True"/><local:RouteButton Bus="A2"/><local:RouteButton Bus="A3"/>
                    <local:RouteButton Bus="B1" IsChecked="True"/><local:RouteButton Bus="B2"/>
                    <local:RouteButton Bus="A1" IsEnabled="False"/>
                    <local:MuteToggle/><local:MuteToggle IsChecked="True"/>
                    <local:MuteToggle GlyphOn="&#xE720;" GlyphOff="&#xF781;" IsChecked="True"/>
                </StackPanel>
                <ToggleButton x:Uid="ControlsGalleryWindow008" Style="{StaticResource MicButtonStyle}" >
                    <StackPanel Orientation="Horizontal" Spacing="12"><FontIcon Glyph="&#xE720;"/><StackPanel>
                        <TextBlock x:Uid="ControlsGalleryWindow009" /><TextBlock x:Uid="ControlsGalleryWindow010"  FontSize="12"/>
                    </StackPanel></StackPanel>
                </ToggleButton>
                <local:Fader x:Uid="ControlsGalleryWindow011" x:Name="HorizontalFader" Orientation="Horizontal" />
                <local:VuMeter x:Uid="ControlsGalleryWindow012" x:Name="HorizontalMeter" Height="40" Orientation="Horizontal" ShowScale="True" />
                <StackPanel Orientation="Horizontal" Spacing="24" Height="240">
                    <local:Fader x:Uid="ControlsGalleryWindow013" Orientation="Vertical" Width="48" />
                    <local:Fader x:Uid="ControlsGalleryWindow014" Orientation="Vertical" Width="48" IsMuted="True" Value="-6" />
                    <local:VuMeter x:Uid="ControlsGalleryWindow015" x:Name="VerticalMeter" Width="60" ShowScale="True" />
                    <local:VuMeter x:Uid="ControlsGalleryWindow016" x:Name="MonoMeter" Width="16" IsStereo="False" IsMuted="True" />
                </StackPanel>
                <TextBlock x:Uid="ControlsGalleryWindow017"  TextWrapping="Wrap"/>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
