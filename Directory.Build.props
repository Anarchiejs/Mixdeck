<Project>
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Deterministic>true</Deterministic>
    <Company>Mixdeck</Company>
    <Product>Mixdeck</Product>
    <Version>0.1.0</Version>
    <AnalysisLevel>latest</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <!-- VoicemeeterRemote64.dll est 64 bits : l'appli WinUI et les services Win32 restent en x64.
         Mixdeck.Voicemeeter et Mixdeck.FlStudio ciblent net10.0 pour que le simulateur et le protocole tournent aussi sur macOS. -->
    <IsWindowsProject Condition="$(MSBuildProjectName.EndsWith('.Platform')) or $(MSBuildProjectName.EndsWith('.App'))">true</IsWindowsProject>
  </PropertyGroup>
  <PropertyGroup Condition="'$(IsWindowsProject)' == 'true'">
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">win-x64</RuntimeIdentifier>
  </PropertyGroup>
</Project>
